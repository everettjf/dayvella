    "Dayvella": {
      "shouldTranslate": false
    },
    "Dayvella imports JSON arrays where every item represents an entry. Each one can be a count-up or count-down with its own timezone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayvella imports JSON arrays where every item represents an entry. Each one can be a count-up or count-down with its own timezone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayvella 可导入 JSON 数组，每个元素对应一条记录。每条记录都可以累计天数或倒计时，并使用独立时区。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DayvellaはJSON配列を読み込み、各要素を記録として扱います。記録ごとに経過日数またはカウントダウンと、タイムゾーンを設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayvella는 각 항목이 하나의 기록인 JSON 배열을 가져옵니다. 기록마다 누적 일수 또는 카운트다운과 시간대를 설정할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayvella importiert JSON-Arrays, in denen jedes Element einen Eintrag darstellt. Jeder Eintrag kann vergangene Tage oder einen Countdown mit eigener Zeitzone enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayvella importe des tableaux JSON dont chaque élément représente une entrée. Chaque entrée peut compter les jours écoulés ou restants, avec son propre fuseau horaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayvella importa matrices JSON donde cada elemento representa un registro. Cada registro puede contar días transcurridos o restantes con su propia zona horaria."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayvella importa array JSON in cui ogni elemento rappresenta una voce. Ogni voce può contare i giorni trascorsi o rimanenti con il proprio fuso orario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dayvella importa arrays JSON em que cada item representa um registro. Cada registro pode contar dias decorridos ou restantes com seu próprio fuso horário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayvella импортирует массивы JSON, где каждый элемент — отдельная запись. Для каждой записи можно задать подсчёт прошедших дней или обратный отсчёт и свой часовой пояс."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayvella nhập mảng JSON, trong đó mỗi phần tử là một mục. Mỗi mục có thể đếm ngày đã qua hoặc đếm ngược với múi giờ riêng."
          }
        }
      }
    },
