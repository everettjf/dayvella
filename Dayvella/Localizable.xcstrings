          }
        }
      }
    },
    "This will permanently delete all entries, including archived and pinned items.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete all entries, including archived and pinned items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除所有记录，包括已归档和已置顶的记录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ済みやピン留めした記録を含む、すべての記録が完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관하거나 고정한 기록을 포함하여 모든 기록이 영구적으로 삭제됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einträge, auch archivierte und angeheftete, werden dauerhaft gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les entrées, y compris celles archivées et épinglées, seront définitivement supprimées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de forma permanente todos los registros, incluidos los archivados y fijados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le voci, incluse quelle archiviate e fissate, verranno eliminate definitivamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os registros, incluindo os arquivados e fixados, serão excluídos permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все записи, включая архивные и закреплённые, будут удалены навсегда."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả các mục, kể cả mục đã lưu trữ và đã ghim, sẽ bị xóa vĩnh viễn."
          }
        }
      }
    },
