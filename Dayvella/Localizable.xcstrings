          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que exportar. Añade un registro primero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono voci da esportare. Aggiungi prima una voce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há registros para exportar. Adicione um registro primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего экспортировать. Сначала добавьте запись."
