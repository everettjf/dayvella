    "Generate a snapshot of all entries in the same schema. You can archive it, hand it to friends, or re-import later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate a snapshot of all entries in the same schema. You can archive it, hand it to friends, or re-import later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按相同格式导出所有记录的快照。你可以保存备份、分享给朋友，或在以后重新导入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての記録を同じ形式で書き出します。保存したり、友達に渡したり、後で再び読み込んだりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기록을 같은 형식으로 내보냅니다. 보관하거나 친구에게 공유하거나 나중에 다시 가져올 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine Momentaufnahme aller Einträge im selben Format. Du kannst sie archivieren, mit Freunden teilen oder später wieder importieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez un instantané de toutes les entrées dans le même format. Vous pouvez le conserver, le partager ou le réimporter plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera una copia de todos los registros con el mismo formato. Puedes archivarla, compartirla o volver a importarla más adelante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta una copia di tutte le voci nello stesso formato. Puoi archiviarla, condividerla o importarla di nuovo in seguito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere uma cópia de todos os registros no mesmo formato. Você pode arquivá-la, compartilhá-la ou importá-la novamente depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте снимок всех записей в том же формате. Его можно сохранить, передать друзьям или импортировать позже."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xuất bản sao của tất cả các mục theo cùng định dạng. Bạn có thể lưu trữ, chia sẻ hoặc nhập lại sau."
          }
        }
      }
    },
