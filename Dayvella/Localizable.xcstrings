            "value": "Nothing to export yet. Add an entry first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有可导出的内容，请先添加记录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出す記録がありません。まず記録を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낼 기록이 없습니다. 먼저 기록을 추가하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zum Exportieren. Füge zuerst einen Eintrag hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entrée à exporter. Ajoutez d’abord une entrée."
          }
        },
