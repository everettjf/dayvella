    "Notifications are delivered at 8:00 AM in the entry's time zone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are delivered at 8:00 AM in the entry's time zone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知会在记录所在时区的上午 8:00 发送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は記録のタイムゾーンの午前8時に届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 기록의 시간대를 기준으로 오전 8시에 전달됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen werden um 8:00 Uhr in der Zeitzone des Eintrags gesendet."
          }
        },
        "fr": {
