        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목이나 메모로 검색하세요. 입력하면 일치하는 기록이 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Titel oder Notizen. Beginne zu tippen, um Treffer zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez par titre ou par notes. Commencez à saisir pour voir les résultats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca por título o notas. Empieza a escribir para ver los resultados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca per titolo o note. Inizia a digitare per vedere i risultati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque por título ou notas. Comece a digitar para ver os resultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите по названию или заметкам. Начните вводить текст, чтобы увидеть результаты."
