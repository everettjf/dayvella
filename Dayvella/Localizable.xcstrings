          "stringUnit": {
            "state": "translated",
            "value": "提示：重新导入已导出的文件时，会跳过 ID 相同的记录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：書き出したファイルを再度読み込む際、IDが一致する記録はスキップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 내보낸 파일을 다시 가져올 때 ID가 같은 기록은 건너뜁니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Beim erneuten Import einer exportierten Datei werden Einträge mit identischen IDs übersprungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : lors de la réimportation d’un fichier exporté, les entrées avec des identifiants identiques sont ignorées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: al volver a importar un archivo exportado, se omiten los registros con ID coincidentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: quando reimporti un file esportato, le voci con ID corrispondenti vengono ignorate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: ao importar novamente um arquivo exportado, os registros com IDs iguais são ignorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: при повторном импорте экспортированного файла записи с совпадающими ID пропускаются."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẹo: khi nhập lại tệp đã xuất, các mục có cùng ID sẽ bị bỏ qua."
          }
        }
      }
    },
