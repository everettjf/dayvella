    "Count down to something special, or track how far you’ve come.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count down to something special, or track how far you’ve come."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "期待特别的一天，或记录一路走来的时光。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特別な日までカウントダウンしたり、これまでの歩みを記録しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특별한 날을 기다리거나, 지금까지 걸어온 시간을 기록해 보세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähle die Tage bis zu einem besonderen Anlass oder halte fest, wie weit du gekommen bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez les jours avant un événement spécial ou mesurez le chemin parcouru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta los días hasta un momento especial o registra cuánto has avanzado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta i giorni fino a un momento speciale o tieni traccia dei tuoi progressi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte os dias até um momento especial ou acompanhe o quanto você já avançou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считайте дни до особого события или следите за своим прогрессом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đếm ngược đến một dịp đặc biệt hoặc theo dõi hành trình đã qua."
          }
        }
      }
    },
