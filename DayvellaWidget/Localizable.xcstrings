    "Dayvella": {
      "shouldTranslate": false
    },
    "See your pinned or nearest day counter at a glance.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your pinned or nearest day counter at a glance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼查看置顶记录或最近的倒计时。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めした記録や、日付が近い記録をひと目で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정한 기록이나 가장 가까운 날짜의 카운터를 한눈에 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh deine angehefteten oder zeitlich nächsten Tageszähler auf einen Blick."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez vos compteurs épinglés ou les plus proches en un coup d’œil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta de un vistazo tus contadores fijados o los más próximos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza a colpo d’occhio i contatori fissati o più vicini."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja de relance os contadores fixados ou mais próximos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённые или ближайшие события с первого взгляда."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nhanh bộ đếm đã ghim hoặc gần nhất."
          }
        }
      }
    },
